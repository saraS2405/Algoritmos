primeiro= int(input("Digite o 1° número inteiro:"))
maior = primeiro
menor = primeiro

for i in range (2,6):
    print("Digite o", i,"° número inteiro:")
    n= int(input())
    
    if n > maior:
        maior = n
        if n < menor:
            menor = n
            
print("O MAIOR número digitado foi: ", maior)
print("O MENOR número digitado foi: ", menor)


        